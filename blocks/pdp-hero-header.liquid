{% liquid
  assign product = closest.product

  assign subtitle = product.metafields.custom.pdp_subtitle.value
  assign stock_badge = product.metafields.custom.pdp_stock_badge.value
  assign viewing_badge = product.metafields.custom.pdp_viewing_badge.value
  assign short_description = product.metafields.custom.pdp_short_description.value

  if stock_badge == blank
    assign stock_badge = block.settings.fallback_stock_badge
  endif

  if viewing_badge == blank
    assign viewing_badge = block.settings.fallback_viewing_badge
  endif

  if short_description == blank and block.settings.use_product_description_fallback
    assign short_description = product.description | strip_html | strip | truncatewords: 28
  endif
%}

<div
  class="pdp-hero-header spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% if subtitle != blank %}
    <p class="pdp-hero-header__eyebrow">
      {{ subtitle | escape }}
    </p>
  {% endif %}

  <h1 class="pdp-hero-header__title">
    {{ product.title | escape }}
  </h1>

  {% if stock_badge != blank or viewing_badge != blank %}
    <div class="pdp-hero-header__badges">
      {% if stock_badge != blank %}
        <span class="pdp-hero-header__badge pdp-hero-header__badge--stock">
          <span class="pdp-hero-header__badge-dot"></span>
          {{ stock_badge | escape }}
        </span>
      {% endif %}

      {% if viewing_badge != blank %}
        <span class="pdp-hero-header__badge pdp-hero-header__badge--viewing">
          <span class="pdp-hero-header__badge-dot"></span>
          {{ viewing_badge | escape }}
        </span>
      {% endif %}
    </div>
  {% endif %}
  {% if short_description != blank %}
    <div class="pdp-hero-header__description">
      {{ short_description | newline_to_br }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .pdp-hero-header {
    display: grid;
    gap: 0.75rem;
  }

  .pdp-hero-header__eyebrow {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.68);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .pdp-hero-header__title {
    margin: 0;
    color: var(--pdp-hero-ink);
    font-family: var(--font-recoleta);
    font-size: clamp(2rem, 8vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .pdp-hero-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pdp-hero-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 1.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: 0.75rem;
    line-height: 1;
    white-space: nowrap;
  }

  .pdp-hero-header__badge-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .pdp-hero-header__badge--stock {
    background: var(--pdp-hero-stock-bg);
    color: var(--pdp-hero-stock-text);
  }

  .pdp-hero-header__badge--stock .pdp-hero-header__badge-dot {
    background: #ff3030b5;
  }

  .pdp-hero-header__badge--viewing {
    background: var(--pdp-hero-viewing-bg);
    color: var(--pdp-hero-viewing-text);
  }

  .pdp-hero-header__badge--viewing .pdp-hero-header__badge-dot {
    background: #a4c472;
  }

  .pdp-hero-header__description {
    max-width: 44ch;
    color: var(--pdp-hero-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media screen and (min-width: 750px) {
    .pdp-hero-header__title {
      font-size: clamp(2.75rem, 4vw, 4rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP hero header",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "fallback_stock_badge",
      "label": "Fallback stock badge",
      "default": "Limited Stock"
    },
    {
      "type": "text",
      "id": "fallback_viewing_badge",
      "label": "Fallback viewing badge",
      "default": "23 people viewing this now"
    },
    {
      "type": "checkbox",
      "id": "use_product_description_fallback",
      "label": "Use product description fallback",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "PDP hero header",
      "category": "Product"
    }
  ]
}
{% endschema %}
