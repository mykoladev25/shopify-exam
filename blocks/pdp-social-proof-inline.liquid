<script src="{{ 'dialog.js' | asset_url }}" type="module"></script>

<div class="pdp-inline-social-proof" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="pdp-inline-social-proof__heading">
      {{ block.settings.heading | escape }}
    </h2>
  {% endif %}

  <div class="pdp-inline-social-proof__list" role="list">
    {% for i in (1..5) %}
      {% liquid
        assign avatar_key = 'avatar_' | append: i
        assign name_key = 'name_' | append: i
        assign modal_title_key = 'modal_title_' | append: i
        assign video_url_key = 'video_url_' | append: i
        assign caption_key = 'caption_' | append: i
        assign avatar = block.settings[avatar_key]
        assign name = block.settings[name_key]
        assign modal_title = block.settings[modal_title_key]
        assign video = block.settings[video_url_key]
        assign caption = block.settings[caption_key]
      %}
      {% if avatar != blank or name != blank or video != blank %}
        <dialog-component class="pdp-inline-social-proof__card">
          <button
            class="pdp-inline-social-proof__button button button-unstyled"
            type="button"
            on:click="/showDialog"
            aria-label="{{ name | default: block.settings.heading | escape }}"
          >
            {% if avatar != blank %}
              {{
                avatar
                | image_url: width: 160
                | image_tag:
                  class: 'pdp-inline-social-proof__avatar',
                  loading: 'lazy',
                  widths: '80,120,160',
                  sizes: '72px',
                  alt: name
              }}
            {% else %}
              <span class="pdp-inline-social-proof__avatar pdp-inline-social-proof__avatar--placeholder"></span>
            {% endif %}
            <span class="pdp-inline-social-proof__play">
              {{ 'icon-play.svg' | inline_asset_content }}
            </span>
          </button>

          <dialog
            ref="dialog"
            class="pdp-inline-social-proof__dialog dialog-modal"
            scroll-lock
            aria-labelledby="pdp-inline-social-proof-title-{{ block.id }}-{{ i }}"
          >
            <div class="pdp-inline-social-proof__dialog-inner">
              <h3 id="pdp-inline-social-proof-title-{{ block.id }}-{{ i }}" class="pdp-inline-social-proof__dialog-title">
                {{ modal_title | default: name | default: block.settings.heading | escape }}
              </h3>

              <div class="pdp-inline-social-proof__video-frame">
                {% if video != blank %}
                  {% if video.type == 'youtube' %}
                    <iframe
                      src="https://www.youtube.com/embed/{{ video.id }}?autoplay=1&rel=0"
                      title="{{ modal_title | default: name | escape }}"
                      loading="lazy"
                      allow="autoplay; encrypted-media; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  {% elsif video.type == 'vimeo' %}
                    <iframe
                      src="https://player.vimeo.com/video/{{ video.id }}?autoplay=1"
                      title="{{ modal_title | default: name | escape }}"
                      loading="lazy"
                      allow="autoplay; fullscreen; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  {% endif %}
                {% else %}
                  <div class="pdp-inline-social-proof__video-placeholder">Add YouTube/Vimeo URL in the editor</div>
                {% endif %}
              </div>

              {% if caption != blank %}
                <div class="pdp-inline-social-proof__caption">
                  {{ caption }}
                </div>
              {% endif %}

              <button
                ref="closeButton"
                on:click="/closeDialog"
                class="pdp-inline-social-proof__close button button-unstyled close-button"
                aria-label="{{ 'accessibility.close_dialog' | t }}"
              >
                {{ 'icon-close.svg' | inline_asset_content }}
              </button>
            </div>
          </dialog>
        </dialog-component>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .pdp-inline-social-proof {
    padding-top: 1.25rem;
    border-top: 1px solid var(--pdp-hero-line);
  }

  .pdp-inline-social-proof__heading {
    margin: 0 0 1rem;
    color: var(--pdp-hero-ink);
    font-family: var(--font-recoleta);
    font-size: clamp(1.625rem, 6vw, 2.125rem);
    font-weight: 400;
    line-height: 1;
  }

  .pdp-inline-social-proof__list {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pdp-inline-social-proof__list::-webkit-scrollbar {
    display: none;
  }

  .pdp-inline-social-proof__card {
    flex: 0 0 auto;
  }

  .pdp-inline-social-proof__button {
    position: relative;
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    padding: 0;
    border-radius: 50%;
  }

  .pdp-inline-social-proof__avatar {
    width: 100%;
    height: 100%;
    border: 2px solid #445037;
    border-radius: 50%;
    object-fit: cover;
  }

  .pdp-inline-social-proof__avatar--placeholder {
    display: block;
    background: #d7d4ca;
  }

  .pdp-inline-social-proof__play {
    position: absolute;
    right: -0.125rem;
    bottom: -0.125rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 10px rgb(0 0 0 / 12%);
  }

  .pdp-inline-social-proof__play svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  .pdp-inline-social-proof__dialog {
    width: min(92vw, 48rem);
    padding: 0;
    border: 0;
    border-radius: 1rem;
    background: #fff;
  }

  .pdp-inline-social-proof__dialog-inner {
    position: relative;
    padding: 1rem;
  }

  .pdp-inline-social-proof__dialog-title {
    margin: 0 0 0.75rem;
    color: var(--pdp-hero-ink);
    font-family: var(--font-recoleta);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .pdp-inline-social-proof__video-frame {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 0.875rem;
    background: #111;
  }

  .pdp-inline-social-proof__video-frame iframe,
  .pdp-inline-social-proof__video-placeholder {
    width: 100%;
    height: 100%;
  }

  .pdp-inline-social-proof__video-placeholder {
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 0.9375rem;
  }

  .pdp-inline-social-proof__caption {
    margin-top: 0.75rem;
    color: var(--pdp-hero-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .pdp-inline-social-proof__caption > * {
    margin: 0;
  }

  .pdp-inline-social-proof__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }
{% endstylesheet %}

