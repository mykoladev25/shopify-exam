            "pdp_benefits_inline": {
              "type": "pdp-benefits-inline",
              "settings": {
                "heading": "Why you need this?",
                "title_1": "Fall asleep faster and wake up fully rested",
                "text_1": "<p>Use icon and text from the editor.</p>",
                "title_2": "Less joint pain and morning stiffness",
                "text_2": "<p>Use icon and text from the editor.</p>",
                "title_3": "Calmer mood and lower daily stress",
                "text_3": "<p>Use icon and text from the editor.</p>"
              }
            },
            "pdp_social_proof_inline": {
              "type": "pdp-social-proof-inline",
              "settings": {
                "heading": "Real People. Real Healing.",
                "name_1": "Customer story 1",
                "modal_title_1": "Customer story 1",
                "name_2": "Customer story 2",
                "modal_title_2": "Customer story 2",
                "name_3": "Customer story 3",
                "modal_title_3": "Customer story 3"
              }
            },
            "pdp_tabs_inline": {
              "type": "pdp-product-tabs-inline",
              "settings": {
                "navigation_label": "Product information",
                "heading_1": "Description",
                "use_product_description_1": true,
                "content_1": "",
                "heading_2": "Who is it for?",
                "use_product_description_2": false,
                "content_2": "<p>Connect a product metafield or enter content here.</p>",
                "heading_3": "Shipping and returns",
                "use_product_description_3": false,
                "content_3": "<p>Connect a product metafield or enter content here.</p>",
                "heading_4": "Care Instructions",
                "use_product_description_4": false,
                "content_4": "<p>Connect a product metafield or enter content here.</p>"
              }
            }
          },
          "block_order": [
            "pdp_hero_header",
            "price_main",
            "variant_picker_main",
            "buy_buttons_main",
            "pdp_benefits_inline",
            "pdp_social_proof_inline",
            "pdp_tabs_inline"
          ]
        }
      },
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": true,
        "limit_details_width": false,
        "gap": 32,
        "enable_sticky_add_to_cart": false,
        "color_scheme": "scheme-1",
        "padding-block-start": 12,
        "padding-block-end": 24
      }
