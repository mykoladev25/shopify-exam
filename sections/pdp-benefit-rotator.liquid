<script src="{{ 'pdp-sections.js' | asset_url }}" type="module"></script>

<div class="pdp-benefit-rotator section section--page-width color-{{ section.settings.color_scheme }}" data-pdp-benefit-rotator data-rotate-seconds="{{ section.settings.rotate_seconds }}">
  <div class="pdp-benefit-rotator__inner">
    {% if section.blocks.size > 0 %}
      <div class="pdp-benefit-rotator__layout">
        <div class="pdp-benefit-rotator__intro">
          {% if section.settings.heading != blank %}
            <h2 class="pdp-benefit-rotator__heading">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.body != blank %}
            <div class="pdp-benefit-rotator__body rte">{{ section.settings.body }}</div>
          {% endif %}
        </div>

        <div
          class="pdp-benefit-rotator__mobile-active-pill"
          data-rotator-mobile-active
          aria-hidden="true"
        ></div>

        <div class="pdp-benefit-rotator__nav" role="tablist" aria-label="{{ section.settings.heading | strip_html | escape }}">
          {% for block in section.blocks %}
            {% liquid
              assign inline_icon_markup = blank
              if block.settings.icon_asset != blank
                capture inline_icon_markup
                  echo block.settings.icon_asset | inline_asset_content
                endcapture
                if inline_icon_markup contains 'Asset not found'
                  assign inline_icon_markup = blank
                endif
              endif
            %}
            <button
              class="pdp-benefit-rotator__pill{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-rotator-trigger
              data-target="benefit-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% if inline_icon_markup != blank %}
                <span class="pdp-benefit-rotator__pill-icon pdp-benefit-rotator__pill-icon--inline" aria-hidden="true">
                  {{ inline_icon_markup }}
                </span>
              {% elsif block.settings.icon != blank %}
                {{
                  block.settings.icon
                  | image_url: width: 48
                  | image_tag:
                      class: 'pdp-benefit-rotator__pill-icon pdp-benefit-rotator__pill-icon--image',
                      loading: 'lazy',
                      decoding: 'async',
                      fetchpriority: 'low',
                      widths: '24,36,48',
                      sizes: '18px',
                      alt: block.settings.label
                }}
              {% endif %}
              <span>{{ block.settings.label | escape }}</span>
            </button>
          {% endfor %}
        </div>

        <div class="pdp-benefit-rotator__panels">
          {% for block in section.blocks %}
            <article
              id="benefit-{{ section.id }}-{{ block.id }}"
              class="pdp-benefit-rotator__panel{% if forloop.first %} is-active{% endif %}"
              data-rotator-panel
            >
              <div class="pdp-benefit-rotator__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'pdp-benefit-rotator__image',
                      loading: 'lazy',
                      decoding: 'async',
                      fetchpriority: 'low',
                      widths: '360,540,720,900',
                      sizes: '(min-width: 750px) 40vw, 100vw',
                      alt: block.settings.title
                  }}
                {% endif %}
              </div>

              <div class="pdp-benefit-rotator__content">
                {% if block.settings.title != blank %}
                  <h3 class="pdp-benefit-rotator__title">{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="pdp-benefit-rotator__description rte">{{ block.settings.description }}</div>
                {% endif %}

                {% if block.settings.link_label != blank and block.settings.link_url != blank %}
                  <a class="pdp-benefit-rotator__link" href="{{ block.settings.link_url }}">
                      {{- 'icon-tube.svg' | inline_asset_content -}}
                    <span class="pdp-benefit-rotator__text">
                      {{ block.settings.link_label | escape }}
                    </span>
                  </a>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>

        {% if section.blocks.size > 1 %}
          <div class="pdp-benefit-rotator__arrows" aria-hidden="true">
            <button class="pdp-benefit-rotator__arrow pdp-benefit-rotator__arrow--prev" type="button" data-rotator-prev aria-label="Previous slide">
              {{ 'icon-chevron-left.svg' | inline_asset_content }}
            </button>
            <button class="pdp-benefit-rotator__arrow pdp-benefit-rotator__arrow--next" type="button" data-rotator-next aria-label="Next slide">
              {{ 'icon-chevron-right.svg' | inline_asset_content }}
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .pdp-benefit-rotator {
    padding: 2rem var(--padding-lg);
    background: #F4F3EE;
    content-visibility: auto;
    contain-intrinsic-size: 1px 900px;
  }

  .pdp-benefit-rotator__inner {
    margin: 0 auto;
  }

  .pdp-benefit-rotator__heading {
    margin: 0 0 0.875rem;
    color: var(--pdp-hero-ink);
    font-family: var(--font-recoleta);
    font-size: clamp(1.5rem, 6vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: normal;
    text-align: center;
    padding: 0 26px;
  }

  .pdp-benefit-rotator__panels {
    order: 2;
  }

  .pdp-benefit-rotator__arrows {
    display: none;
  }

  .pdp-benefit-rotator__body {
    max-width: 42rem;
    margin: 0 auto;
    color: var(--pdp-hero-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-align: center;
  }

  .pdp-benefit-rotator__body > *:first-child {
    margin-top: 0;
  }

  .pdp-benefit-rotator__layout {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
    contain: layout style;
  }

  .pdp-benefit-rotator__intro {
    order: 0;
  }

  .pdp-benefit-rotator__mobile-active-pill {
    display: block;
    order: 1;
  }

  .pdp-benefit-rotator__nav {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    order: 3;
  }

  .pdp-benefit-rotator__nav::-webkit-scrollbar {
    display: none;
  }

  .pdp-benefit-rotator__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    border: 1px solid #8b8c7c;
    border-radius: 999px;
    background: transparent;
    color: var(--pdp-hero-ink);
    font-size: 0.875rem;
    cursor: pointer;
    font-weight: 700;
    text-align: left;
  }

  .pdp-benefit-rotator__mobile-active-pill .pdp-benefit-rotator__pill {
    width: 100%;
    justify-content: center;
  }

  .pdp-benefit-rotator__nav .pdp-benefit-rotator__pill.is-active {
    display: none;
  }

  .pdp-benefit-rotator__pill.is-active {
    border-color: var(--pdp-hero-ink);
    background: var(--pdp-hero-ink);
    color: white;
  }

  .pdp-benefit-rotator__pill-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .pdp-benefit-rotator__pill-icon--inline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #31331e;
  }

  .pdp-benefit-rotator__pill-icon--inline :is(svg, img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pdp-benefit-rotator__pill-icon--inline svg {
    fill: currentColor;
    stroke: currentColor;
  }

  .pdp-benefit-rotator__pill-icon--inline svg :is(path, circle, rect, ellipse, polygon, polyline, line) {
    fill: currentColor;
    stroke: currentColor;
  }

  .pdp-benefit-rotator__pill-icon--image {
    object-fit: contain;
    filter: brightness(0) saturate(100%) invert(18%) sepia(14%) saturate(717%) hue-rotate(27deg) brightness(95%)
      contrast(92%);
  }

  .pdp-benefit-rotator__pill.is-active .pdp-benefit-rotator__pill-icon--inline {
    color: #fff;
  }

  .pdp-benefit-rotator__pill.is-active .pdp-benefit-rotator__pill-icon--image {
    filter: brightness(0) invert(1);
  }

  .pdp-benefit-rotator__panel {
    display: none;
    overflow: hidden;
    border-radius: 0.5rem;
    background: #2e3520;
    color: #f4f1e6;
  }

  .pdp-benefit-rotator__panel.is-active {
    display: grid;
    order: 2;
  }

  .pdp-benefit-rotator__media {
    display: none;
  }

  .pdp-benefit-rotator__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-benefit-rotator__content {
    display: grid;
    align-content: start;
    gap: calc(35 / 16 * 1rem);
    padding: 1.5rem;
  }

  .pdp-benefit-rotator__title {
    margin: 0;
    font-family: var(--font-recoleta);
    font-size: calc(24 / 16 * 1rem);
    font-weight: 400;
    line-height: normal;
    letter-spacing: -0.03em;
  }

  .pdp-benefit-rotator__description {
    font-size: 1rem;
    line-height: 1.55;
  }

  .pdp-benefit-rotator__description > *:first-child {
    margin-top: 0;
    margin-bottom: calc(35 / 16 * 1rem);
  }

  .pdp-benefit-rotator__description > *:last-child {
    margin-bottom: 0;
  }

  .pdp-benefit-rotator__link {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .pdp-benefit-rotator__link svg {
      margin: 0 auto;
  }

  .pdp-benefit-rotator__text {
    display: block;
    margin-top: calc(10 / 16 * 1rem);
    text-align: center;
  }

  @media screen and (min-width: 1440px) {
    .pdp-benefit-rotator {
      padding: 3rem 0;
    }

    .pdp-benefit-rotator__intro {
      grid-area: intro;
      display: grid;
      align-content: start;
      gap: 0.75rem;
      max-width: none;
      margin-bottom: 0;
    }

    .pdp-benefit-rotator__heading {
      margin-bottom: 0;
      font-size: clamp(3rem, 5.4vw, 4.75rem);
      line-height: 0.94;
      text-align: left;
      padding: 0;
    }

    .pdp-benefit-rotator__body {
      margin: 0;
      max-width: 44rem;
      text-align: left;
      font-size: 1.125rem;
      line-height: 1.45;
    }

    .pdp-benefit-rotator__mobile-active-pill {
      display: none;
    }

    .pdp-benefit-rotator__layout {
      grid-template-columns: minmax(20rem, 1.05fr) minmax(18rem, 0.95fr) minmax(24rem, 1fr);
      grid-template-areas:
        'intro intro content'
        'nav media content';
      align-items: start;
      column-gap: 1.25rem;
      row-gap: 1.5rem;
      margin-top: 0;
    }

    .pdp-benefit-rotator__nav {
      grid-area: nav;
      align-content: start;
      gap: 0.75rem;
      overflow: visible;
      order: 1;
    }

    .pdp-benefit-rotator__nav .pdp-benefit-rotator__pill.is-active {
      display: inline-flex;
    }

    .pdp-benefit-rotator__pill {
      width: 100%;
      justify-content: flex-start;
      padding: 0.875rem 1.25rem;
      font-size: 1rem;
    }

    .pdp-benefit-rotator__panels {
      display: contents;
    }

    .pdp-benefit-rotator__panel.is-active {
      display: contents;
      min-height: 0;
      max-width: none;
      order: 2;
    }

    .pdp-benefit-rotator__media {
      grid-area: media;
      min-height: 100%;
      display: block;
      max-width: 580px;
      width: 100%;
      align-self: stretch;
      border-radius: 0.3125rem;
      overflow: hidden;
      position: relative;
      right: -20px;
    }

    .pdp-benefit-rotator__content {
      grid-area: content;
      min-width: 0;
      min-height: 39rem;
      background: #2e3520;
      padding: 4rem 3.5rem 3rem;
      border-radius: 0.3125rem;
      margin-top: auto;
    }

    .pdp-benefit-rotator__title {
      font-size: 3rem;
      line-height: calc(50 / 16 * 1rem);
    }

    .pdp-benefit-rotator__description {
      font-size: 1.0625rem;
      line-height: 1.5;
    }

    .pdp-benefit-rotator__arrows {
      display: block;
    }

    .pdp-benefit-rotator__arrow {
      position: absolute;
      top: 80%;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3.5rem;
      height: 3.5rem;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: #fff;
      color: var(--pdp-hero-ink);
      box-shadow: 0 12px 24px rgb(48 53 34 / 12%);
      transform: translateY(-50%);
      cursor: pointer;
    }

    .pdp-benefit-rotator__arrow svg {
      width: 1rem;
      height: 1rem;
      display: block;
    }

    .pdp-benefit-rotator__arrow--prev {
      left: calc(36.5% - 1.75rem);
    }

    .pdp-benefit-rotator__arrow--next {
      right: -1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP benefit rotator",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>One Natural Solution. Whole-Body Benefits.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Auto rotate every",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 10
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Pill icon"
        },
        {
          "type": "text",
          "id": "icon_asset",
          "label": "Pill icon asset filename",
          "info": "Theme asset SVG filename, e.g. cardiology.svg. Use this for exact color control."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Pill label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PDP benefit rotator"
    }
  ]
}
{% endschema %}
