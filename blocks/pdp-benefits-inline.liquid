{% liquid
  assign product = closest.product
  assign benefits_heading = product.metafields.custom.pdp_benefits_heading.value | default: block.settings.heading
  assign benefit_items = product.metafields.custom.pdp_benefits_items.value
%}

<div class="pdp-inline-benefits" {{ block.shopify_attributes }}>
  {% if benefits_heading != blank %}
    <h2 class="pdp-inline-benefits__heading">
      {{ benefits_heading | escape }}
    </h2>
  {% endif %}

  <div class="pdp-inline-benefits__grid">
    {% if benefit_items != blank %}
      {% for benefit in benefit_items %}
        {% liquid
          assign icon = benefit.icon.value | default: benefit.icon
          assign title = benefit.title.value | default: benefit.title
          assign text = benefit.text
        %}
        <article class="pdp-inline-benefits__item">
          {% if icon != blank %}
            {{
              icon
              | image_url: width: 64
              | image_tag:
                class: 'pdp-inline-benefits__icon',
                loading: 'lazy',
                decoding: 'async',
                fetchpriority: 'low',
                widths: '32,48,64',
                sizes: '20px',
              alt: title
            }}
          {% endif %}

          {% if title != blank %}
            <h3 class="pdp-inline-benefits__title">
              {{ title | escape }}
            </h3>
          {% endif %}

          {% if text != blank %}
            <div class="pdp-inline-benefits__text">
              {{ text | metafield_tag }}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    {% else %}
      {% for i in (1..6) %}
        {% liquid
          assign icon_key = 'icon_' | append: i
          assign title_key = 'title_' | append: i
          assign text_key = 'text_' | append: i
          assign icon = block.settings[icon_key]
          assign title = block.settings[title_key]
          assign text = block.settings[text_key]
        %}
        {% if title != blank or text != blank or icon != blank %}
          <article class="pdp-inline-benefits__item">
            {% if icon != blank %}
              {{
                icon
                | image_url: width: 64
                | image_tag:
                  class: 'pdp-inline-benefits__icon',
                  loading: 'lazy',
                  decoding: 'async',
                  fetchpriority: 'low',
                  widths: '32,48,64',
                  sizes: '20px',
                  alt: title
              }}
            {% endif %}

            {% if title != blank %}
              <h3 class="pdp-inline-benefits__title">
                {{ title | escape }}
              </h3>
            {% endif %}

            {% if text != blank %}
              <div class="pdp-inline-benefits__text">
                {{ text }}
              </div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .pdp-inline-benefits {
    padding-bottom: 0.25rem;
  }

  .pdp-inline-benefits__heading {
    margin: 0 0 1rem;
    color: var(--pdp-hero-ink);
    font-family: var(--font-recoleta);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .pdp-inline-benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.25rem;
    contain: layout style;
  }

  .pdp-inline-benefits__item {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }

  .pdp-inline-benefits__icon {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
  }

  .pdp-inline-benefits__title {
    margin: 0;
    color: var(--pdp-hero-ink);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .pdp-inline-benefits__text {
    color: var(--pdp-hero-muted);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .pdp-inline-benefits__text > * {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .pdp-inline-benefits__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem 1.5rem;
    }
  }
{% endstylesheet %}

