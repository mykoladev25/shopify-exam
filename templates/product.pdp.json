    "pdp_guarantee_bar": {
      "type": "pdp-guarantee-bar",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "text": "90-Day Results-Backed Guarantee"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "text": "Designed in USA"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "text": "Ships in 2–6 Days"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "text": "A Tree Planted per Order"
          }
        }
      },
      "block_order": ["item_1", "item_2", "item_3", "item_4"],
