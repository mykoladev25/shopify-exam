              "blocks": {}
            },
            "variant_picker_main": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": false,
                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "buy_buttons_main": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_pickup_availability": false,
                "padding-block-start": 4,
                "padding-block-end": 0,
