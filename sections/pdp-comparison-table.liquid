<script src="{{ 'pdp-sections.js' | asset_url }}" type="module"></script>

{% liquid
  assign featured_block = blank

  for block in section.blocks
    if block.settings.highlight
      assign featured_block = block
      break
    endif
  endfor

  if featured_block == blank
    for block in section.blocks
      assign featured_block = block
      break
    endfor
  endif
%}

<div
  class="pdp-comparison section section--page-width color-{{ section.settings.color_scheme }}"
  data-pdp-comparison
  style="--pdp-comparison-highlight-bg: url('{{ 'bg-linear.jpg' | asset_url }}');"
>
  {% liquid
    assign product = closest.product
    assign variant = product.selected_or_first_available_variant
    assign can_add_to_cart = false
    assign add_to_cart_text = 'products.product.unavailable' | t

    if variant
      if variant.available
        assign can_add_to_cart = true
        assign add_to_cart_text = 'products.product.add_to_cart' | t
      elsif variant.inventory_management == 'shopify' and variant.inventory_quantity <= 0 and variant.inventory_policy == 'deny'
        assign add_to_cart_text = 'products.product.sold_out' | t
      endif
    endif
  %}

  <div class="pdp-comparison__inner">
    {% if section.settings.heading != blank %}
      <h2 class="pdp-comparison__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="pdp-comparison__desktop">
      <div class="pdp-comparison__desktop-shell">
        <div class="pdp-comparison__desktop-head pdp-comparison__desktop-grid" role="row">
          <div class="pdp-comparison__head-cell">{{ section.settings.col_solution | escape }}</div>
          <div class="pdp-comparison__head-cell">{{ section.settings.col_how | escape }}</div>
          <div class="pdp-comparison__head-cell">{{ section.settings.col_consider | escape }}</div>
          <div class="pdp-comparison__head-cell">{{ section.settings.col_cost | escape }}</div>
          <div class="pdp-comparison__head-cell">{{ section.settings.col_side_effects | escape }}</div>
        </div>

        {% if featured_block != blank %}
          <div class="pdp-comparison__desktop-grid pdp-comparison__desktop-row is-highlighted" {% if featured_block.shopify_attributes != blank %}{{ featured_block.shopify_attributes }}{% endif %}>
            <div class="pdp-comparison__solution-cell pdp-comparison__solution-cell--featured">
              {% if featured_block.settings.icon != blank %}
                {{
                  featured_block.settings.icon
                  | image_url: width: 180
                  | image_tag:
                    class: 'pdp-comparison__solution-icon pdp-comparison__solution-icon--featured',
                    loading: 'lazy',
                    decoding: 'async',
                    fetchpriority: 'low',
                    widths: '90,120,180',
                    sizes: '80px',
                    alt: featured_block.settings.solution
                }}
              {% endif %}
              {% if featured_block.settings.solution_logo != blank %}
                {{
                  featured_block.settings.solution_logo
                  | image_url: width: 220
                  | image_tag:
                    class: 'pdp-comparison__solution-wordmark',
                    loading: 'lazy',
                    decoding: 'async',
                    fetchpriority: 'low',
                    widths: '110,160,220',
                    sizes: '154px',
                    alt: featured_block.settings.solution
                }}
              {% else %}
                <span>{{ featured_block.settings.solution | escape }}</span>
              {% endif %}
            </div>
            <div class="pdp-comparison__body-cell">{{ featured_block.settings.how_it_works | newline_to_br }}</div>
            <div class="pdp-comparison__body-cell">{{ featured_block.settings.what_to_consider | newline_to_br }}</div>
            <div class="pdp-comparison__body-cell">{{ featured_block.settings.cost_over_time | newline_to_br }}</div>
            <div class="pdp-comparison__body-cell">{{ featured_block.settings.side_effects | newline_to_br }}</div>
          </div>
        {% endif %}

        <div class="pdp-comparison__desktop-body">
          {% for block in section.blocks %}
            {% if featured_block == blank or block.id != featured_block.id %}
              <div class="pdp-comparison__desktop-grid pdp-comparison__desktop-row" {{ block.shopify_attributes }}>
                <div class="pdp-comparison__solution-cell">
                  {% if block.settings.icon != blank %}
                    {{
                      block.settings.icon
                      | image_url: width: 120
                      | image_tag:
                        class: 'pdp-comparison__solution-icon',
                        loading: 'lazy',
                        decoding: 'async',
                        fetchpriority: 'low',
                        widths: '60,90,120',
                        sizes: '56px',
                        alt: block.settings.solution
                    }}
                  {% endif %}
                  <span>{{ block.settings.solution | escape }}</span>
                </div>
                <div class="pdp-comparison__body-cell">{{ block.settings.how_it_works | newline_to_br }}</div>
                <div class="pdp-comparison__body-cell">{{ block.settings.what_to_consider | newline_to_br }}</div>
                <div class="pdp-comparison__body-cell">{{ block.settings.cost_over_time | newline_to_br }}</div>
                <div class="pdp-comparison__body-cell">{{ block.settings.side_effects | newline_to_br }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="pdp-comparison__mobile-shell">
      <div class="pdp-comparison__mobile-solution">
        <article class="pdp-comparison__mobile-panel">
          <div class="pdp-comparison__mobile-panel-heading">{{ section.settings.col_solution | escape }}</div>

          {% if featured_block != blank %}
            <div class="pdp-comparison__mobile-solution-featured">
              {% if featured_block.settings.icon != blank %}
                {{
                  featured_block.settings.icon
                  | image_url: width: 180
                  | image_tag:
                    class: 'pdp-comparison__solution-icon pdp-comparison__solution-icon--featured',
                    loading: 'lazy',
                    decoding: 'async',
                    fetchpriority: 'low',
                    widths: '90,120,180',
                    sizes: '80px',
                    alt: featured_block.settings.solution
                }}
              {% endif %}
              {% if featured_block.settings.solution_logo != blank %}
                {{
                  featured_block.settings.solution_logo
                  | image_url: width: 220
                  | image_tag:
                    class: 'pdp-comparison__solution-wordmark',
                    loading: 'lazy',
                    decoding: 'async',
                    fetchpriority: 'low',
                    widths: '110,160,220',
                    sizes: '98px',
                    alt: featured_block.settings.solution
                }}
              {% else %}
                <span>{{ featured_block.settings.solution | escape }}</span>
              {% endif %}
            </div>
          {% endif %}

          <div class="pdp-comparison__mobile-solution-list">
            {% for block in section.blocks %}
              {% if featured_block == blank or block.id != featured_block.id %}
                <div class="pdp-comparison__mobile-solution-row" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank %}
                    {{
                      block.settings.icon
                      | image_url: width: 96
                      | image_tag:
                        class: 'pdp-comparison__solution-icon',
                        loading: 'lazy',
                        decoding: 'async',
                        fetchpriority: 'low',
                        widths: '48,72,96',
                        sizes: '38px',
                        alt: block.settings.solution
                    }}
                  {% endif %}
                  <span>{{ block.settings.solution | escape }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </article>
      </div>

      <div class="pdp-comparison__mobile">
        <div class="pdp-comparison__cards" data-comparison-cards>
          <article class="pdp-comparison__card is-highlighted">
            <div class="pdp-comparison__mobile-panel-heading">{{ section.settings.col_how | escape }}</div>
            {% if featured_block != blank %}
              <div class="pdp-comparison__mobile-featured-value">
                {{ featured_block.settings.how_it_works | newline_to_br }}
              </div>
            {% endif %}
            <div class="pdp-comparison__mobile-value-list">
              {% for block in section.blocks %}
                {% if featured_block == blank or block.id != featured_block.id %}
                  <div class="pdp-comparison__mobile-value-row">{{ block.settings.how_it_works | newline_to_br }}</div>
                {% endif %}
              {% endfor %}
            </div>
          </article>

          <article class="pdp-comparison__card">
            <div class="pdp-comparison__mobile-panel-heading">{{ section.settings.col_consider | escape }}</div>
            {% if featured_block != blank %}
              <div class="pdp-comparison__mobile-featured-value">
                {{ featured_block.settings.what_to_consider | newline_to_br }}
              </div>
            {% endif %}
            <div class="pdp-comparison__mobile-value-list">
              {% for block in section.blocks %}
                {% if featured_block == blank or block.id != featured_block.id %}
                  <div class="pdp-comparison__mobile-value-row">{{ block.settings.what_to_consider | newline_to_br }}</div>
                {% endif %}
              {% endfor %}
            </div>
          </article>

          <article class="pdp-comparison__card">
            <div class="pdp-comparison__mobile-panel-heading">{{ section.settings.col_cost | escape }}</div>
            {% if featured_block != blank %}
              <div class="pdp-comparison__mobile-featured-value">
                {{ featured_block.settings.cost_over_time | newline_to_br }}
              </div>
            {% endif %}
            <div class="pdp-comparison__mobile-value-list">
              {% for block in section.blocks %}
                {% if featured_block == blank or block.id != featured_block.id %}
                  <div class="pdp-comparison__mobile-value-row">{{ block.settings.cost_over_time | newline_to_br }}</div>
                {% endif %}
              {% endfor %}
            </div>
          </article>

          <article class="pdp-comparison__card">
            <div class="pdp-comparison__mobile-panel-heading">{{ section.settings.col_side_effects | escape }}</div>
            {% if featured_block != blank %}
              <div class="pdp-comparison__mobile-featured-value">
                {{ featured_block.settings.side_effects | newline_to_br }}
              </div>
            {% endif %}
            <div class="pdp-comparison__mobile-value-list">
              {% for block in section.blocks %}
                {% if featured_block == blank or block.id != featured_block.id %}
                  <div class="pdp-comparison__mobile-value-row">{{ block.settings.side_effects | newline_to_br }}</div>
                {% endif %}
              {% endfor %}
            </div>
          </article>
        </div>

        <div class="pdp-comparison__dots" data-comparison-dots>
          <button class="pdp-comparison__dot is-active" type="button" data-comparison-dot aria-label="{{ section.settings.col_how | escape }}"></button>
          <button class="pdp-comparison__dot" type="button" data-comparison-dot aria-label="{{ section.settings.col_consider | escape }}"></button>
          <button class="pdp-comparison__dot" type="button" data-comparison-dot aria-label="{{ section.settings.col_cost | escape }}"></button>
          <button class="pdp-comparison__dot" type="button" data-comparison-dot aria-label="{{ section.settings.col_side_effects | escape }}"></button>
        </div>
      </div>
    </div>
  </div>
  {% if product != blank %}
        {%- assign product_form_id = 'PdpComparison-ProductForm-' | append: section.id -%}
        <product-form-component
          class="pdp-comparison__cta"
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-product-url="{{ product.url }}"
          on:submit="/handleSubmit"
        >
          {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
            <input
              type="hidden"
              name="id"
              value="{{ variant.id }}"
            >
            {% render 'add-to-cart-button',
              id: 'PdpComparison-SubmitButton-' | append: section.id,
              class: 'add-to-cart-button button',
              can_add_to_cart: can_add_to_cart,
              product: product,
              add_to_cart_text: 'ADD TO CART',
              data_testid: 'pdp-comparison-add-to-cart'
            %}
          {%- endform -%}
        </product-form-component>
      {% endif %}
</div>
{% stylesheet %}
  .pdp-comparison {
    padding: 0.5rem 0 0.5rem;
    background: #F4F3EE;
    overflow-x: clip;
  }

  .pdp-comparison__inner {
    max-width: 82rem;
    margin: 0 auto;
  }

  .pdp-comparison__heading {
    margin: 0 0 1.5rem;
    color: #31331e;
    font-family: var(--font-recoleta);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
  }

  .pdp-comparison__desktop {
    display: none;
  }

  .pdp-comparison__mobile-shell {
    display: grid;
    grid-template-columns: minmax(6.75rem, 7rem) minmax(0, 1fr);
    gap: 0.875rem;
    align-items: start;
  }

  .pdp-comparison__mobile-solution,
  .pdp-comparison__mobile {
    min-width: 0;
    overflow: visible;
  }

  .pdp-comparison__mobile-panel {
    min-height: 21.6875rem;
    border-radius: 0.25rem;
    background: #fff;
    box-shadow: 0 0.424rem 1.061rem rgb(0 0 0 / 0.05);
    overflow: visible;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .pdp-comparison__mobile-panel-heading {
    padding: 1rem 0.875rem 0.875rem;
    color: #31331e;
    font-size: 0.6875rem;
    line-height: 1.2;
    text-align: center;
  }

  .pdp-comparison__mobile-solution-featured,
  .pdp-comparison__mobile-featured-value {
    position: relative;
    min-height: 5.0625rem;
    margin: 0;
    padding: 0.875rem 0.9375rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    border-radius: 0.25rem;
    color: #fff;
    background-color: #5f8e43;
    background-image: var(--pdp-comparison-highlight-bg);
    background-position: 2%;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .pdp-comparison__mobile-solution-featured {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin-top: 0.125rem;
    margin-right: -0.875rem;
    padding-right: calc(0.9375rem + 0.875rem);
    text-align: center;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.2;
    position: relative;
    align-items: flex-end;
  }

  .pdp-comparison__mobile-value-list,
  .pdp-comparison__mobile-solution-list {
    display: grid;
  }

  .pdp-comparison__mobile-value-row,
  .pdp-comparison__mobile-solution-row {
    min-height: 5.8125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 0.625rem;
    border-top: 1px solid rgb(49 51 30 / 0.2);
    color: #31331e;
    font-size: 0.6875rem;
    line-height: 1.18;
  }

  .pdp-comparison__mobile-value-row {
    align-items: flex-start;
    justify-content: flex-start;
    padding-inline: 0.75rem;
  }

  .pdp-comparison__mobile-solution-row {
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }

  .pdp-comparison__cards {
    display: flex;
    gap: 0.875rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    contain: content;
    min-width: 0;
  }

  .pdp-comparison__cards::-webkit-scrollbar {
    display: none;
  }

  .pdp-comparison__card {
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-height: 21.6875rem;
    border-radius: 0.25rem;
    background: #fff;
    box-shadow: 0 0.424rem 1.061rem rgb(0 0 0 / 0.05);
    overflow: hidden;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .pdp-comparison__mobile-featured-value {
    display: flex;
    align-items: center;
    font-size: 0.6875rem;
    line-height: 1.18;
  }

  .pdp-comparison__solution-icon {
    width: 2.375rem;
    height: 2.375rem;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .pdp-comparison__solution-icon--featured {
    height: auto;
    width: calc(54 / 16 * 1rem);
    height: calc(54 / 16 * 1rem);
    rotate: -16.95deg;
    opacity: 1;
    border-radius: 5px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 0;
  }

  .pdp-comparison__solution-wordmark {
    width: auto;
    max-width: calc(98 / 16 * 1rem);
    height: calc(24 / 16 * 1rem);
    object-fit: contain;
  }

  .pdp-comparison__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .pdp-comparison__dot {
    width: 0.625rem;
    height: 0.625rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #3a3a3a;
  }

  .pdp-comparison__dot.is-active {
    background: #a8ca1b;
  }

  @media screen and (min-width: 1440px) {
    .pdp-comparison {
      padding: 1rem 0 2rem;
    }

    .pdp-comparison__solution-icon--featured {
      height: auto;
      width: calc(80 / 16 * 1rem);
      height: calc(80 / 16 * 1rem);
    }

    .pdp-comparison__heading {
      margin-bottom: 2rem;
      font-size: clamp(2.75rem, 5vw, 4.375rem);
      line-height: 1.05;
    }

    .pdp-comparison__mobile-shell {
      display: none;
    }

    .pdp-comparison__desktop {
      display: block;
    }

    .pdp-comparison__cta .button.add-to-cart-button {
      max-width: calc(372 / 16 * 1rem);
    }

    .pdp-comparison__cta  form {
      padding-top: 0.5rem;
    }

    .pdp-comparison__desktop-shell {
      padding: 1.25rem 1.25rem 1.5rem;
      border-radius: 0.3125rem;
      background: #fff;
      box-shadow: 0 0.625rem 1.5625rem rgb(0 0 0 / 0.05);
    }

    .pdp-comparison__desktop-grid {
      display: grid;
      grid-template-columns: minmax(10rem, 1.08fr) minmax(16rem, 2.05fr) minmax(14rem, 1.75fr) minmax(10rem, 1.05fr) minmax(14rem, 1.35fr);
    }

    .pdp-comparison__desktop-head {
      align-items: end;
      min-height: 3.5rem;
    }

    .pdp-comparison__head-cell {
      padding: 0 1rem 0.875rem;
      color: #31331e;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.25;
      text-align: center;
    }

    .pdp-comparison__desktop-row {
      align-items: stretch;
    }

    .pdp-comparison__desktop-row + .pdp-comparison__desktop-row {
      border-top: 1px solid rgb(49 51 30 / 0.24);
    }

    .pdp-comparison__desktop-row.is-highlighted {
      position: relative;
      margin: 0;
      border-radius: 0.3125rem;
      overflow: visible;
      z-index: 1;
    }

    .pdp-comparison__desktop-row.is-highlighted::before {
      content: '';
      position: absolute;
      inset: 0 -1.5rem;
      border-radius: 0.3125rem;
      background-color: #5f8e43;
      background-image: var(--pdp-comparison-highlight-bg);
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      z-index: -1;
    }

    .pdp-comparison__desktop-row.is-highlighted .pdp-comparison__body-cell,
    .pdp-comparison__desktop-row.is-highlighted .pdp-comparison__solution-cell {
      color: #fff;
      border-color: rgb(255 255 255 / 0.18);
      border-left: transparent;
    }

    .pdp-comparison__solution-cell,
    .pdp-comparison__body-cell {
      padding: 1.625rem 1.2rem;
      color: #31331e;
      font-size: 1rem;
      line-height: 1.25;
      min-height: 7.3125rem;
      position: relative;
      background: transparent;
    }

    .pdp-comparison__solution-cell:not(:first-child),
    .pdp-comparison__body-cell:not(:first-child),
    .pdp-comparison__head-cell:not(:first-child) {
      border-left: 1px solid rgb(49 51 30 / 0.24);
    }

    .pdp-comparison__solution-cell {
      display: grid;
      align-content: center;
      justify-items: center;
      gap: 0.75rem;
      text-align: center;
      font-weight: 700;
    }

    .pdp-comparison__solution-cell--featured {
      justify-items: start;
      text-align: left;
      gap: 0.875rem;
      position: relative;
    }

    .pdp-comparison__solution-cell--featured:has(img) {
      padding-top: calc(70 / 16 * 1rem);
    }

    .pdp-comparison__solution-cell--featured .pdp-comparison__solution-wordmark {
      max-width: calc(154 / 16 * 1rem);
      height: calc(38 / 16 * 1rem);
    }

    .pdp-comparison__body-cell {
      display: flex;
      align-items: center;
    }

    .pdp-comparison__desktop-row.is-highlighted .pdp-comparison__body-cell {
      font-weight: 700;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP comparison table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Are Really Different"
    },
    {
      "type": "text",
      "id": "col_solution",
      "label": "Column 1 heading",
      "default": "Solution"
    },
    {
      "type": "text",
      "id": "col_how",
      "label": "Column 2 heading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "col_consider",
      "label": "Column 3 heading",
      "default": "What to consider"
    },
    {
      "type": "text",
      "id": "col_cost",
      "label": "Column 4 heading",
      "default": "Cost over time"
    },
    {
      "type": "text",
      "id": "col_side_effects",
      "label": "Column 5 heading",
      "default": "Side effects"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight row",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Solution icon"
        },
        {
          "type": "text",
          "id": "solution",
          "label": "Solution"
        },
        {
          "type": "image_picker",
          "id": "solution_logo",
          "label": "Solution logo"
        },
        {
          "type": "textarea",
          "id": "how_it_works",
          "label": "How it works"
        },
        {
          "type": "textarea",
          "id": "what_to_consider",
          "label": "What to consider"
        },
        {
          "type": "textarea",
          "id": "cost_over_time",
          "label": "Cost over time"
        },
        {
          "type": "textarea",
          "id": "side_effects",
          "label": "Side effects"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP comparison table"
    }
  ]
}
{% endschema %}
