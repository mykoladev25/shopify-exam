<script src="{{ 'pdp-sections.js' | asset_url }}" type="module"></script>

{% liquid
  assign product = closest.product
  assign tab_1_heading = product.metafields.custom.pdp_tab_description_heading.value | default: block.settings.heading_1
  assign tab_2_heading = product.metafields.custom.pdp_tab_who_is_it_for_heading.value | default: block.settings.heading_2
  assign tab_3_heading = product.metafields.custom.pdp_tab_shipping_returns_heading.value | default: block.settings.heading_3
  assign tab_4_heading = product.metafields.custom.pdp_tab_care_instructions_heading.value | default: block.settings.heading_4

  capture tab_1_content
    if product.metafields.custom.pdp_tab_description != blank
      echo product.metafields.custom.pdp_tab_description | metafield_tag
    elsif block.settings.use_product_description_1
      echo product.description
    else
      echo block.settings.content_1
    endif
  endcapture
  assign tab_1_content = tab_1_content | strip

  capture tab_2_content
    if product.metafields.custom.pdp_tab_who_is_it_for != blank
      echo product.metafields.custom.pdp_tab_who_is_it_for | metafield_tag
    elsif block.settings.use_product_description_2
      echo product.description
    else
      echo block.settings.content_2
    endif
  endcapture
  assign tab_2_content = tab_2_content | strip

  capture tab_3_content
    if product.metafields.custom.pdp_tab_shipping_returns != blank
      echo product.metafields.custom.pdp_tab_shipping_returns | metafield_tag
    elsif block.settings.use_product_description_3
      echo product.description
    else
      echo block.settings.content_3
    endif
  endcapture
  assign tab_3_content = tab_3_content | strip

  capture tab_4_content
    if product.metafields.custom.pdp_tab_care_instructions != blank
      echo product.metafields.custom.pdp_tab_care_instructions | metafield_tag
    elsif block.settings.use_product_description_4
      echo product.description
    else
      echo block.settings.content_4
    endif
  endcapture
  assign tab_4_content = tab_4_content | strip
%}

<div class="pdp-inline-tabs" data-pdp-inline-tabs {{ block.shopify_attributes }}>
  <div class="pdp-inline-tabs__desktop-nav" role="tablist" aria-label="{{ block.settings.navigation_label | escape }}">
    {% if tab_1_heading != blank and tab_1_content != blank %}
      <button class="pdp-inline-tabs__tab is-active" type="button" role="tab" data-tab-button data-tab-target="inline-tab-{{ block.id }}-1" aria-selected="true">
        {{ tab_1_heading | escape }}
      </button>
    {% endif %}
    {% if tab_2_heading != blank and tab_2_content != blank %}
      <button class="pdp-inline-tabs__tab{% if tab_1_content == blank %} is-active{% endif %}" type="button" role="tab" data-tab-button data-tab-target="inline-tab-{{ block.id }}-2" aria-selected="{% if tab_1_content == blank %}true{% else %}false{% endif %}">
        {{ tab_2_heading | escape }}
      </button>
    {% endif %}
    {% if tab_3_heading != blank and tab_3_content != blank %}
      <button class="pdp-inline-tabs__tab{% if tab_1_content == blank and tab_2_content == blank %} is-active{% endif %}" type="button" role="tab" data-tab-button data-tab-target="inline-tab-{{ block.id }}-3" aria-selected="{% if tab_1_content == blank and tab_2_content == blank %}true{% else %}false{% endif %}">
        {{ tab_3_heading | escape }}
      </button>
    {% endif %}
    {% if tab_4_heading != blank and tab_4_content != blank %}
      <button class="pdp-inline-tabs__tab{% if tab_1_content == blank and tab_2_content == blank and tab_3_content == blank %} is-active{% endif %}" type="button" role="tab" data-tab-button data-tab-target="inline-tab-{{ block.id }}-4" aria-selected="{% if tab_1_content == blank and tab_2_content == blank and tab_3_content == blank %}true{% else %}false{% endif %}">
        {{ tab_4_heading | escape }}
      </button>
    {% endif %}
  </div>

  <div class="pdp-inline-tabs__desktop-panels">
    {% if tab_1_heading != blank and tab_1_content != blank %}
      <div id="inline-tab-{{ block.id }}-1" class="pdp-inline-tabs__panel is-active" role="tabpanel" data-tab-panel>
        <div class="pdp-inline-tabs__content rte">{{ tab_1_content }}</div>
      </div>
    {% endif %}
    {% if tab_2_heading != blank and tab_2_content != blank %}
      <div id="inline-tab-{{ block.id }}-2" class="pdp-inline-tabs__panel{% if tab_1_content == blank %} is-active{% endif %}" role="tabpanel" data-tab-panel>
        <div class="pdp-inline-tabs__content rte">{{ tab_2_content }}</div>
      </div>
    {% endif %}
    {% if tab_3_heading != blank and tab_3_content != blank %}
      <div id="inline-tab-{{ block.id }}-3" class="pdp-inline-tabs__panel{% if tab_1_content == blank and tab_2_content == blank %} is-active{% endif %}" role="tabpanel" data-tab-panel>
        <div class="pdp-inline-tabs__content rte">{{ tab_3_content }}</div>
      </div>
    {% endif %}
    {% if tab_4_heading != blank and tab_4_content != blank %}
      <div id="inline-tab-{{ block.id }}-4" class="pdp-inline-tabs__panel{% if tab_1_content == blank and tab_2_content == blank and tab_3_content == blank %} is-active{% endif %}" role="tabpanel" data-tab-panel>
        <div class="pdp-inline-tabs__content rte">{{ tab_4_content }}</div>
      </div>
    {% endif %}
  </div>

  <div class="pdp-inline-tabs__mobile">
    {% if tab_1_heading != blank and tab_1_content != blank %}
      <details class="pdp-inline-tabs__accordion" open>
        <summary class="pdp-inline-tabs__accordion-summary">
          {{ tab_1_heading | escape }}
          <span class="pdp-inline-tabs__accordion-icon">{{ 'icon-plus.svg' | inline_asset_content }}</span>
        </summary>
        <div class="pdp-inline-tabs__accordion-content rte">{{ tab_1_content }}</div>
      </details>
    {% endif %}
    {% if tab_2_heading != blank and tab_2_content != blank %}
      <details class="pdp-inline-tabs__accordion" {% if tab_1_content == blank %}open{% endif %}>
        <summary class="pdp-inline-tabs__accordion-summary">
          {{ tab_2_heading | escape }}
          <span class="pdp-inline-tabs__accordion-icon">{{ 'icon-plus.svg' | inline_asset_content }}</span>
        </summary>
        <div class="pdp-inline-tabs__accordion-content rte">{{ tab_2_content }}</div>
      </details>
    {% endif %}
    {% if tab_3_heading != blank and tab_3_content != blank %}
      <details class="pdp-inline-tabs__accordion" {% if tab_1_content == blank and tab_2_content == blank %}open{% endif %}>
        <summary class="pdp-inline-tabs__accordion-summary">
          {{ tab_3_heading | escape }}
          <span class="pdp-inline-tabs__accordion-icon">{{ 'icon-plus.svg' | inline_asset_content }}</span>
        </summary>
        <div class="pdp-inline-tabs__accordion-content rte">{{ tab_3_content }}</div>
      </details>
    {% endif %}
    {% if tab_4_heading != blank and tab_4_content != blank %}
      <details class="pdp-inline-tabs__accordion" {% if tab_1_content == blank and tab_2_content == blank and tab_3_content == blank %}open{% endif %}>
        <summary class="pdp-inline-tabs__accordion-summary">
          {{ tab_4_heading | escape }}
          <span class="pdp-inline-tabs__accordion-icon">{{ 'icon-plus.svg' | inline_asset_content }}</span>
        </summary>
        <div class="pdp-inline-tabs__accordion-content rte">{{ tab_4_content }}</div>
      </details>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .pdp-inline-tabs {
    padding-top: 1.25rem;
    border-top: 1px solid var(--pdp-hero-line);
    contain: layout style;
  }

  .pdp-inline-tabs__desktop-nav {
    display: none;
  }

  .pdp-inline-tabs__desktop-panels {
    display: none;
  }

  .pdp-inline-tabs__accordion {
    border-bottom: 1px solid var(--pdp-hero-line);
  }

  .pdp-inline-tabs__accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    list-style: none;
    color: var(--pdp-hero-ink);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }

  .pdp-inline-tabs__accordion-summary::-webkit-details-marker {
    display: none;
  }

  .pdp-inline-tabs__accordion-icon {
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }

  .pdp-inline-tabs__accordion[open] .pdp-inline-tabs__accordion-icon {
    transform: rotate(45deg);
  }

  .pdp-inline-tabs__accordion-content,
  .pdp-inline-tabs__content {
    padding-bottom: 1rem;
    color: var(--pdp-hero-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .pdp-inline-tabs__accordion-content > *:first-child,
  .pdp-inline-tabs__content > *:first-child {
    margin-top: 0;
    margin-bottom: 0;
  }

  .pdp-inline-tabs__accordion-content > *:last-child,
  .pdp-inline-tabs__content > *:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .pdp-inline-tabs__desktop-nav {
      display: flex;
      gap: 1.5rem;
      border-bottom: 1px solid var(--pdp-hero-line);
    }

    .pdp-inline-tabs__tab {
      position: relative;
      padding: 1rem 0 0.875rem;
      border: 0;
      background: transparent;
      color: #91917f;
      font-size: 0.9375rem;
      cursor: pointer;
    }

    .pdp-inline-tabs__tab::after {
      content: '';
      position: absolute;
      right: 0;
      bottom: -1px;
      left: 0;
      height: 3px;
      border-radius: 999px;
      background: var(--pdp-hero-ink);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.2s ease;
    }

    .pdp-inline-tabs__tab.is-active {
      color: var(--pdp-hero-ink);
    }

    .pdp-inline-tabs__tab.is-active::after {
      transform: scaleX(1);
    }

    .pdp-inline-tabs__desktop-panels {
      display: block;
      padding-top: 1.25rem;
      content-visibility: auto;
      contain-intrinsic-size: 1px 360px;
    }

    .pdp-inline-tabs__panel {
      display: none;
    }

    .pdp-inline-tabs__panel.is-active {
      display: block;
    }

    .pdp-inline-tabs__mobile {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP product tabs inline",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Navigation label",
      "default": "Product information"
    },
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading 1",
      "default": "Description"
    },
    {
      "type": "checkbox",
      "id": "use_product_description_1",
      "label": "Use product description 1",
      "default": true
    },
    {
      "type": "richtext",
      "id": "content_1",
      "label": "Content 1"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading 2",
      "default": "Who is it for?"
    },
    {
      "type": "checkbox",
      "id": "use_product_description_2",
      "label": "Use product description 2",
      "default": false
    },
    {
      "type": "richtext",
      "id": "content_2",
      "label": "Content 2"
    },
    {
      "type": "header",
      "content": "Tab 3"
    },
    {
      "type": "text",
      "id": "heading_3",
      "label": "Heading 3",
      "default": "Shipping and returns"
    },
    {
      "type": "checkbox",
      "id": "use_product_description_3",
      "label": "Use product description 3",
      "default": false
    },
    {
      "type": "richtext",
      "id": "content_3",
      "label": "Content 3"
    },
    {
      "type": "header",
      "content": "Tab 4"
    },
    {
      "type": "text",
      "id": "heading_4",
      "label": "Heading 4",
      "default": "Care Instructions"
    },
    {
      "type": "checkbox",
      "id": "use_product_description_4",
      "label": "Use product description 4",
      "default": false
    },
    {
      "type": "richtext",
      "id": "content_4",
      "label": "Content 4"
    }
  ]
}
{% endschema %}
